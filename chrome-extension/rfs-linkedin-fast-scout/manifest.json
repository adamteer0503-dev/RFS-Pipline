{
  "manifest_version": 3,
  "name": "RFS LinkedIn Fast-Scout",
  "version": "1.0",
  "description": "Scout founders and investors on LinkedIn, score their profile match, and generate personalized invites to Run For Startups morning running sessions.",
  "permissions": ["activeTab", "storage", "clipboardWrite"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "RFS LinkedIn Fast-Scout",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
